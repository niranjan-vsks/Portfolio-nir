# ask_niranjan chatbot (bullseye/08). Without these, the chatbot runs in a
# grounded mock mode (keyword retrieval over portfolio-assets/content).

# Groq (Llama 3.1 8B) — required for live LLM answers.
# TODO(niranjan): set this in .env.local
GROQ_API_KEY=

# pgvector store (Supabase or equivalent) — required for vector retrieval.
# Until set, retrieval falls back to in-memory keyword search.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Embeddings provider for the ingest script (optional; pick one).
# OPENAI_API_KEY=
