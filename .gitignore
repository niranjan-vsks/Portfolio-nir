# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local debug logs (logger.ts -> instance/logs_dd_mm_yyyy.log)
/instance/

# Playwright verification artifacts (PRD 20)
/verification/
/test-results/
/playwright-report/
/blob-report/

# local screenshots / mcp output
/.playwright-mcp/
/r2*.jpeg

.vercel

# private, never commit
NIRANJAN_PRIVATE_NOTES.md
